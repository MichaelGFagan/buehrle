# Copy to .env (untracked) and fill in. Read by:
#   - docker compose (automatically, from the repo root)
#   - the buehrle-loads systemd service (EnvironmentFile=)
#   - your shell, when running loaders by hand: set -a; . ./.env; set +a
#
# Plain KEY=value lines only - no quotes, no `export`, no spaces around `=`.

BUEHRLE_BACKEND=ducklake

# Postgres catalog password. Must be set before the first `docker compose up`;
# Postgres ignores it once the data volume exists.
BUEHRLE_POSTGRES_PASSWORD=change-me
BUEHRLE_DUCKLAKE_CATALOG=postgresql://buehrle:change-me@localhost:5432/buehrle_ducklake

# Loaders running at once. 16 GB of RAM handles the default (4).
# BUEHRLE_MAX_CONCURRENCY=4
